#!/usr/bin/env bash
# @feature architecture-tooling
# @feature commit-review
# @feature audit-registry
# @feature work-history
# @spec docs/features/architecture-tooling.md
# @spec docs/features/commit-review.md
# @spec docs/features/audit-registry.md
# @spec docs/features/work-history.md
set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
source "${repository_root}/scripts/work-capture.sh"
if [[ "${NEXUS_PRE_COMMIT_BODY:-}" != 1 ]]; then
  NEXUS_PRE_COMMIT_BODY=1 nexus_work_exec git.hook "Git pre-commit" bash "${repository_root}/.githooks/pre-commit" "$@"
  exit "$?"
fi
unset NEXUS_PRE_COMMIT_BODY
nexus_work_git_hook pre-commit
(
  # Fixture repositories must resolve from their own cwd, not Git's hook context.
  while IFS= read -r git_variable; do
    unset "${git_variable}"
  done < <(git rev-parse --local-env-vars)
  nexus_work_exec validation "Repository validation" "${repository_root}/scripts/check.sh"
)

audit_options=()
audit_root="$(git rev-parse --path-format=absolute --git-common-dir)/nexus-audit-reviews"
if mkdir -p -m 700 "${audit_root}" && audit_attempt="$(mktemp -d "${audit_root}/commit-XXXXXXXX")"; then
  audit_options=(--audit-control cross-model-review@1 --audit-record "${audit_attempt}/review.json")
else
  printf '%s\n' "warning: private Audit replay directory unavailable; review will run without capture" >&2
fi
if ! cargo run --quiet --manifest-path "${repository_root}/Cargo.toml" --bin nexus -- review-commit "${audit_options[@]}"; then
  printf '%s\n' "warning: cross-model commit review or Audit recording failed; reconcile evidence; deterministic checks passed" >&2
fi
